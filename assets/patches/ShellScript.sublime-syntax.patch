+      - vardef-alias-maybe-more
       - vardef-value
       - vardef-assign
       - vardef-alias-name
@@ -414,8 +414,20 @@
     - match: (?=\S)
       push: [vardef-value, vardef-assign, vardef-name]
 
+  vardef-alias-maybe-more:
+    - meta_include_prototype: false
+    - match: (?=`|\s*#)
+      pop: true
+    - include: cmd-args-boilerplate
+    - match: (?=\S)
+      push: [vardef-value, vardef-assign, vardef-alias-name]
+
   vardef-alias-options:
-    - match: \s*((-)p)
+    - match: \s*(--)(?=\s|$)
+      captures:
+        1: keyword.operator.end-of-options.shell
+      pop: true
+    - match: \s*((-)p)(?=\s|$)
       captures:
         2: punctuation.definition.parameter.shell
         1: variable.parameter.option.shell
@@ -429,7 +441,7 @@
         - meta_content_scope: entity.name.function.alias.shell
