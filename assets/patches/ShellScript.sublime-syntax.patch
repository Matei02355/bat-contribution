   - .zshenv
   - .zshrc
   - PKGBUILD  # https://jlk.fjfi.cvut.cz/arch/manpages/man/PKGBUILD.5
-  - .ebuild
-  - .eclass
+  - ebuild
+  - eclass
 
 first_line_match: |
   (?x)
-    ^\#! .* \b(bash|zsh|sh|tcsh|ash)\b
